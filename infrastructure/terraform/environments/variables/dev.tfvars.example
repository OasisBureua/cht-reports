# CHT Reports: dev.tfvars.example
# Copy to dev.tfvars for local applies:
#   cp dev.tfvars.example dev.tfvars
#
# Non-secret infra values mirror dev.github.tfvars; secrets are left blank
# and should be provided via TF_VAR_* or a non-committed dev.tfvars file.

project     = "cht-reports"
environment = "dev"

lambda_images = {
  generator = "233636046512.dkr.ecr.us-east-1.amazonaws.com/cht-reports-dev-generator:1.0.0"
}

lambda_timeout     = 300
lambda_memory_size = 1024

generate_schedule_expression = "cron(0 6 * * ? *)"
enable_generate_schedule     = true

contenthub_base_url = "https://devhub.communityhealth.media/api/public"
contenthub_api_key  = ""

alarm_notification_emails = []
s3_force_destroy          = true
